# HyperFrames scratch output (re-created by `npx hyperframes check` / `snapshot` / `render`)
.hyperframes/
renders/
node_modules/
# Landing-page capture: only the extracted tokens/text/inventory are needed to re-plan; the raw page and
# scroll screenshots are large and regenerated by `npx hyperframes capture`.
capture/screenshots/
capture/extracted/page.html
# the staged copies live in assets/ (and the screenshots in ../images); re-run capture to rebuild this folder
capture/assets/
audio_request.json
audio_engine_meta.json
# Recorded footage: the user's own camera/screen recording and Clips Hub screenshots (footage/ raw, assets/footage/
# prepared). Kept local, published only inside the YouTube video. Without them frames v2-02/03/04 render empty
# windows; see STORYBOARD.md v2 for the shot list.
footage/
# Studio preview caches
.thumbnails/
.waveform-cache/
