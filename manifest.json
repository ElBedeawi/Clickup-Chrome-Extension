{
  "manifest_version": 3,
  "name": "Video & Screenshot Uploader for ClickUp",
  "short_name": "Uploader for ClickUp",
  "version": "1.0.0",
  "description": "Record your screen or capture and annotate screenshots, then attach them to a new or existing ClickUp task. By MacawsHub.",
  "author": "MacawsHub",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["sidePanel", "storage", "offscreen", "scripting"],
  "host_permissions": ["https://api.clickup.com/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video & Screenshot Uploader for ClickUp",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html"
}
